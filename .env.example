# ==========================================
# KD Code Environment Configuration
# ==========================================

# ------------------------------------------
# Database Configuration (PostgreSQL + pgvector)
# ------------------------------------------
# Default credentials for local Docker container (container name: kdcode)
DATABASE_URL=postgres://kdcode:password@localhost:5432/kdcode

# ------------------------------------------
# Ecosystem Sibling Paths (Optional if checked out alongside)
# ------------------------------------------
# Defaults to ../<repo>/... relative to krusch-ide root
# KRUSCH_CONTEXT_MCP=../krusch-context-mcp/src/index.js
# KRUSCH_HARNESS=../krusch/bin/krusch.js
# KRUSCH_PRE_ROUTER=../krusch-pre-router/dist/index.js

# ------------------------------------------
# Ecosystem Bridge Daemon Configuration
# ------------------------------------------
# Bridge listens on 127.0.0.1 by default for secure local communication
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=3778

# ------------------------------------------
# Web Server & UI Configuration
# ------------------------------------------
# Port for the Vite development server and web UI
PORT=5733
HOST=localhost
VITE_HTTP_URL=http://localhost:5733
VITE_WS_URL=ws://localhost:5733

# ------------------------------------------
# AI Provider Configuration
# ------------------------------------------
# API Key for Google Gemini integrations
GEMINI_API_KEY=your_gemini_api_key_here

# API Key for Anthropic Claude integrations
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# API Key for OpenAI or compatible endpoints
OPENAI_API_KEY=your_openai_api_key_here

# Local URL for Ollama embeddings / inference
OLLAMA_URL=http://localhost:11434

# ------------------------------------------
# Desktop Thin-Client Configuration
# ------------------------------------------
# Directory for KD Code local state (defaults to ~/.kdcode)
KDCODE_HOME=~/.kdcode
# Provide a remote backend address when running desktop app as thin client
VITE_DEV_SERVER_URL=http://localhost:5733
# Set to '1' to disable automatic Electron updates
KDCODE_DISABLE_AUTO_UPDATE=0
